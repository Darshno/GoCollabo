# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# These two are REQUIRED for sign-in to work in the browser.
# Copy your project URL and anon/publishable key from:
#   Supabase dashboard → Project Settings → API → Project URL / anon public
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ─── Server (Express / tRPC) ─────────────────────────────────────────────────
# The server reads the same project URL and the same anon/publishable key.
# It also accepts SUPABASE_PUBLISHABLE_KEY as a fallback for SUPABASE_ANON_KEY.
# The server NEVER needs or uses the service-role (secret) key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ─── Optional ────────────────────────────────────────────────────────────────
# Google Maps browser key — restrict by HTTP referrer in Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY=your-restricted-google-maps-browser-key

NODE_ENV=development
PORT=3000
