# Browser-visible Supabase project values (anon/publishable key is protected by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Express/tRPC server uses the same project and anon key with the request user's JWT.
# No service-role key is required by the application.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional direct Google Maps integration used only by the unused map component.
# Restrict this browser key by HTTP referrer in Google Cloud.
# VITE_GOOGLE_MAPS_API_KEY=your-restricted-google-maps-browser-key

NODE_ENV=development
PORT=3000
